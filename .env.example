# ARMA PFA — VERSION FINALE commentaires + sentiment — copier en .env puis remplacer les valeurs.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/arma_marketing

# Collecte Google / Google News
SERPER_API_KEY=your_serper_api_key
BI_MAX_RESULTS_PER_QUERY=10
BI_MIN_STORE_SCORE=0.40
SOCIAL_MAX_RESULTS_PER_QUERY=5
SOCIAL_ORGANIZATIONS=ARMA,OZONE,Averda,Suez Maroc,SOS
SOCIAL_PLATFORMS=Facebook,Instagram,LinkedIn,X

# IA/NLP — architecture recommandée
ANTHROPIC_API_KEY=your_anthropic_api_key
SENTIMENT_PROVIDER=huggingface
COMMENT_TRIAGE_PROVIDER=claude
COMMENT_TRIAGE_MODEL=claude-haiku-4-5-20251001
RESPONSE_DRAFT_PROVIDER=claude
POST_CONTENT_PROVIDER=claude

# Robustesse et garde-fous de génération
POST_TARGET_COUNT=8
POST_FALLBACK_PROVIDER=template
LLM_MAX_RETRIES=2
POST_MAX_TOKENS=1400
RESPONSE_MAX_TOKENS=1800
COMMENT_TRIAGE_MAX_TOKENS=600
SENTIMENT_MAX_TOKENS=450

# Meta Graph API — optionnel, selon les autorisations réellement accordées
META_ACCESS_TOKEN=your_meta_page_or_user_access_token
META_GRAPH_VERSION=vXX.X
META_GRAPH_API_VERSION=vXX.X
META_PAGE_ID=
META_APP_ID=
META_FACEBOOK_PAGE_IDS={}
DEMO_FACEBOOK_COMMENTS=false
META_COMMENT_LOOKBACK_DAYS=30
META_COMMENT_POST_LIMIT=50
META_COMMENT_PAGE_SIZE=100
META_COMMENT_MAX_PAGES=3
META_COMMENT_MAX_REPLY_DEPTH=1

# Instagram professionnel accessible — optionnel
INSTAGRAM_BUSINESS_ACCOUNT_ID=YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID
INSTAGRAM_OFFICIAL_USERNAME=arma.environnement
INSTAGRAM_MEDIA_LIMIT=25
INSTAGRAM_COMMENT_PAGE_SIZE=100

# X API v2 — complément optionnel à Serper
X_BEARER_TOKEN=your_x_bearer_token
X_API_BASE_URL=https://api.x.com/2
X_MAX_RESULTS=25

# Portail et alertes
ALERT_LOOKBACK_DAYS=90
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# n8n — laisser vide pour un POC strictement local ; définir une valeur longue
# si l'API est exposée sur un réseau. Mettre la même valeur dans le nœud
# « Configuration ARMA » du workflow.
N8N_ORCHESTRATION_TOKEN=

# Captures automatiques des publications Facebook publiques retenues.
# Aucun compte, cookie ou contournement d'authentification n'est utilisé.
FACEBOOK_SCREENSHOT_ENABLED=false
FACEBOOK_SCREENSHOT_VISIBLE=false
FACEBOOK_SCREENSHOT_SCROLLS=8
FACEBOOK_SCREENSHOT_PAUSE_SECONDS=2.0
FACEBOOK_SCREENSHOT_MAX_LINKS=20
FACEBOOK_SCREENSHOT_KEEP_RUNS=10

# Collecte des commentaires Facebook publics via Apify.
# Le token reste uniquement dans .env et n'est jamais envoyé au frontend/n8n.
FACEBOOK_COMMENTS_PROVIDER=apify
APIFY_FACEBOOK_COMMENTS_ENABLED=true
APIFY_API_TOKEN=your_apify_api_token
APIFY_FACEBOOK_ACTOR_ID=apify/facebook-comments-scraper
APIFY_API_BASE_URL=https://api.apify.com
APIFY_MAX_POSTS_PER_RUN=20
# Mode final : collecte le plus de commentaires publics possible par URL.
# Augmenter cette limite peut augmenter le coût Apify.
APIFY_COLLECT_ALL_COMMENTS=true
APIFY_ALL_COMMENTS_LIMIT=500
APIFY_MAX_COMMENTS_PER_POST=500
APIFY_INCLUDE_REPLIES=true
APIFY_COMMENTS_MODE=Newest
# Laisser vide pour stocker/classer tout l'historique public disponible.
# Le score et l'écran des alertes appliquent ensuite leurs propres périodes.
APIFY_ONLY_COMMENTS_NEWER_THAN=
APIFY_RUN_TIMEOUT_SECONDS=300
# Retente individuellement les posts qui retournent 0 commentaire dans le run groupé.
APIFY_RETRY_EMPTY_POSTS=true
APIFY_EMPTY_POST_RETRY_LIMIT=5
APIFY_STORE_PROFILE_URLS=false

# Conserve les liens Facebook déjà validés si un export DB est momentanément vide.
FACEBOOK_REGISTRY_PRESERVE_EXISTING=true

# V11 : COMMENT_TRIAGE_PROVIDER peut rester sur claude.
# Si Anthropic est temporairement indisponible ou sans crédit, le tri des
# commentaires bascule automatiquement sur les règles strictes pour ce run.
